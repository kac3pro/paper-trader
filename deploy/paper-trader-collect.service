# systemd unit for the market collector (events, order books, METARs).
# Install on the VPS (fills in your user; the repo copy stays a template, so `git push vps`
# keeps working):
#
#   sed "s/CHANGE_ME/$USER/g" deploy/paper-trader-collect.service | sudo tee /etc/systemd/system/paper-trader-collect.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paper-trader-collect
#   journalctl -u paper-trader-collect -f        # follow the logs
#
# Check the uv path in ExecStart with `which uv`.

[Unit]
Description=Paper trader collector (Polymarket Warsaw max temperature)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/paper-trader
ExecStart=/home/CHANGE_ME/.local/bin/uv run --frozen --no-dev python -m paper_trader.apps.collect --data-dir data/raw
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# The VPS has no IPv4 and uv's Python downloads come from GitHub; use Debian's python3.
Environment=UV_PYTHON_DOWNLOADS=never

[Install]
WantedBy=multi-user.target
